# Yatrip environment template.
#
# Copy to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is gitignored. Never commit real credentials.

# ── Django ──────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata

# ── Database (PostGIS) ──────────────────────────────────────
DB_ENGINE=django.contrib.gis.db.backends.postgis
DB_NAME=yatrip
DB_USER=yatrip
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ── CORS ─────────────────────────────────────────────────────
# Must match the Vite dev server origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ── Model providers (chatbot fallback chain) ─────────────────
# The chain is tried in order until one provider answers. Gemini's free tier
# is capped at ~20 generateContent requests/day, so a second provider is
# strongly recommended.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash

# Groq is the default second link in the chain. Without it, the assistant
# still works but only while Gemini has quota left.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional: override the whole chain as comma-separated "provider:model" pairs,
# tried in order. Providers whose key is missing are skipped automatically, so
# it is safe to list a provider before adding its key.
# Supported: gemini, groq, openai, openrouter
# LLM_PROVIDER_CHAIN=gemini:gemini-3.8-flash,groq:openai/gpt-oss-120b

# ── Vector store (RAG) ───────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX_NAME=yatrip-rag
# Must match the dimensionality of the vectors already in the index.
PINECONE_EMBEDDING_DIMENSION=3072

# ── Web search (optional) ────────────────────────────────────
TAVILY_API_KEY=

# ── MCP tool server ──────────────────────────────────────────
# The chatbot discovers all catalogue/open-data tools over stdio.
MCP_SERVER_ENABLED=True
MCP_SERVER_TRANSPORT=stdio
MCP_SERVER_MODULE=yatrip.mcp_server
MCP_SERVER_TIMEOUT=60
# Only used when MCP_SERVER_TRANSPORT is http/sse
MCP_SERVER_URL=http://127.0.0.1:8000/mcp

# ── OpenStreetMap / Nominatim (optional) ─────────────────────
# Identify your app; the public endpoints block generic user agents.
OSM_USER_AGENT=Yatrip/1.0 (open-source travel assistant)
OVERPASS_TIMEOUT=45

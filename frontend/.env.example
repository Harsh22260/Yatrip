# Frontend environment template.
# Copy to `.env` and restart the dev server.
#
#     cp .env.example .env
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# Do not put secrets here - everything in this file ends up in client JS.

# Django API root, including the /api segment.
VITE_API_URL=http://localhost:8000/api
